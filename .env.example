# ───────────────────────────────────────────────────────────────────────────────
# CRM Freelance — Variables d'environnement
# Copier ce fichier en .env et adapter les valeurs
# ⚠️  Ne jamais committer .env avec des secrets réels
# ───────────────────────────────────────────────────────────────────────────────

# ── Application ────────────────────────────────────────────────────────────────
ENVIRONMENT=local
DEBUG=true

# ── Base de données ────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://crm:crm@localhost:5432/crm

# ── Auth / JWT ─────────────────────────────────────────────────────────────────
# Générer avec : python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME_use_a_32_char_random_hex_string_here
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS ────────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ── Azure Blob Storage (vide = stockage local désactivé en dev) ─────────────────
AZURE_STORAGE_URL=
AZURE_STORAGE_ACCOUNT_NAME=

# ── Azure Key Vault (vide = pas d'utilisation du KV en local) ──────────────────
KEY_VAULT_URL=

# ── Azure Application Insights (vide = télémétrie locale uniquement) ───────────
APPLICATIONINSIGHTS_CONNECTION_STRING=

# ── OpenTelemetry local (Jaeger) ────────────────────────────────────────────────
OTLP_EXPORTER_ENDPOINT=http://localhost:4317

# ── SMTP (MailHog en local) ─────────────────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=crm@localhost
SMTP_PASSWORD=

# ── Frontend ────────────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:8000/api/v1
